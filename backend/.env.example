# ==============================================================================
# MindWeave AI - Backend Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="MindWeave AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security Settings
# Generate a secure random secret key for production environments
SECRET_KEY="generate-a-secure-random-secret-key-for-development"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mindweave_ai"

# AI Integrations
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"
